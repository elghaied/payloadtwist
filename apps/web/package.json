{
  "name": "@payloadtwist/web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run test:int && pnpm run test:e2e",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts",
    "extract-payload-theme": "tsx src/scripts/extract-payload-theme.ts",
    "fetch-google-fonts": "tsx scripts/fetch-google-fonts.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "generate:admin-themes": "tsx src/scripts/generate-admin-themes.ts"
  },
  "dependencies": {
    "@marsidev/react-turnstile": "^1.6.3",
    "@payloadcms/db-sqlite": "4.0.0-beta.10",
    "@payloadcms/next": "4.0.0-beta.10",
    "@payloadcms/richtext-lexical": "4.0.0-beta.10",
    "@payloadcms/translations": "4.0.0-beta.10",
    "@payloadcms/ui": "4.0.0-beta.10",
    "@tailwindcss/postcss": "^4.3.5",
    "better-auth": "^1.7.26",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cross-env": "^10.1.0",
    "dotenv": "16.4.7",
    "drizzle-orm": "^0.45.4",
    "graphql": "^16.15.0",
    "lucide-react": "^0.575.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "payload": "4.0.0-beta.10",
    "payload-admin-ui-themes": "npm:@zubricks/payload-admin-ui-themes@0.1.0",
    "pg": "^8.23.1",
    "postcss": "^8.5.33",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-resizable-panels": "^4.24.1",
    "simple-icons": "^16.38.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.12.3",
    "@types/pg": "^8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "jsdom": "31.0.1",
    "shadcn": "^3.8.5",
    "tsx": "4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "6.0.3",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "5.1.1"
  },
  "engines": {
    "node": ">=24.22.3"
  }
}
